source 'https://github.com/CocoaPods/Specs.git'



platform :ios, '10.0'
use_frameworks!
inhibit_all_warnings!

target 'yugioh' do

  ## 加载图片
  pod 'Kingfisher', '~> 5.0'
  
  pod 'WechatOpenSDK-XCFramework'

  ## 图片放大
  pod "Agrume"

  ## sqlite工具
  pod 'SQLite.swift', '~> 0.12.0' 

  ## 浮动按钮
  pod 'Floaty', '~> 4.2.0'

  ## json工具类
  pod 'SwiftyJSON', '~> 4.0'




  
  
end
